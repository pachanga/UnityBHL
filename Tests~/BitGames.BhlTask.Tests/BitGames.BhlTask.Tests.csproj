<Project Sdk="Microsoft.NET.Sdk">

  <!-- The runtime of the package compiled with stubs of Unity, the VM and UniTask (Stubs.cs, UniTaskStub.cs):
       behavior and allocations; dotnet run -c Release and -c Debug, the exit code is the number of failures -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- the language version of the project's Unity -->
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
    <DefineConstants>$(DefineConstants);BHL_UNITASK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Runtime/Task/*.cs" />
    <!-- BhlFlow is the UniTask bridge: it needs the real UniTask (its async builder, Yield and the
         player loop), which UniTaskStub.cs doesn't fake - a stub of it would only test itself here.
         What the bridge drives, BhlTaskRun, is covered by RunTests.cs -->
    <Compile Remove="../../Runtime/Task/BhlFlow.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
