<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>bindgen</AssemblyName>
    <!-- runs on a newer runtime too, the dotnet found first may have only that one -->
    <RollForward>Major</RollForward>
    <!-- no localized Roslyn messages: a smaller release zip -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- the generator itself is in the Editor assembly, the Unity editor runs it in-process -->
    <Compile Include="../../Editor/BindGen/*.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
