<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>UnityBHL</AssemblyName>
        <OutputType>Library</OutputType>
        <BaseOutputPath>.\.dotnet\bin</BaseOutputPath>
        <RootNamespace>UnityBHL</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>NO_UNITY;</DefineConstants>
        <NoWarn>CS8981;NU1104</NoWarn>
        <ProduceReferenceAssemblyInOutDir>true</ProduceReferenceAssemblyInOutDir>
        <LangVersion>9</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <!-- NOTE: everything else here compiles by default (SDK-style glob) - only
           ScriptBHL.cs, FieldValue.cs, and Bindings/ are fundamentally
           MonoBehaviour/UnityEngine-based, so they're excluded from this build entirely,
           not just conditionally compiled. Any new Unity-independent file is picked up
           automatically; a new Unity-only file needs a Remove added here. -->
      <Compile Remove="ScriptBHL.cs" />
      <Compile Remove="FieldValue.cs" />
      <Compile Remove="Bindings/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\bit\bhl\src\vm\bhl_runtime.csproj"/>
    </ItemGroup>

</Project>
